rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // generatedImages — written by Admin SDK only, never accessible from clients
    match /generatedImages/{doc} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
