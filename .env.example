# ardeemcp environment variables
# Copy to .env and fill in values — never commit .env

# Per-project bearer tokens — format: projectId:token,projectId2:token2
MCP_TOKENS=ardeeportal:your-token-here,ardeej:your-token-here,ardeemcp:your-token-here

# Google AI (Imagen 3)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Firebase Admin SDK (dedicated MCP Firebase project)
FIREBASE_ADMIN_PROJECT_ID=your-mcp-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server config
PORT=3000
